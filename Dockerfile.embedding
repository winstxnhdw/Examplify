FROM python:slim AS model-builder

RUN pip install --no-cache-dir huggingface-hub

RUN python -c \
    "from huggingface_hub import snapshot_download; \
    snapshot_download('Octen/Octen-Embedding-0.6B', revision='5c8a0c35452b7bf57b05069368fae594c44d78c8', local_dir='/model', ignore_patterns=['model.safetensors'])"


FROM ghcr.io/huggingface/text-embeddings-inference:cpu-1.9.4@sha256:2538ea1c9640d3763b15af668039d24172d063b42337b0c27796fc2be180c78d

COPY --from=model-builder /model /model

CMD ["--model-id", "/model", "--served-model-name", "Octen/Octen-Embedding-0.6B", "--dtype", "float32", "--max-batch-tokens", "4096", "--max-batch-requests", "4", "--max-client-batch-size", "4", "--max-concurrent-requests", "8", "--hostname", "0.0.0.0", "--port", "7997"]
